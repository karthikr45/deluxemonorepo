{%- comment -%}
  Deluxe loyalty redemption widget (cart).

  Shows the logged-in shopper's AVAILABLE Zenoti loyalty points and their Rand
  value, and a "Get Discount Code" button that redeems the available points into
  a single-use Shopify discount code via the middleware.

  Points are only DEDUCTED in Zenoti after payment (orders/paid webhook), so
  generating a code here just reserves the points.

  Include on the cart page / cart drawer:
    {% render 'loyalty-redeem' %}

  Set the middleware URL via theme setting `loyalty_middleware_url`
  (Theme editor → Theme settings → Loyalty), or edit the default below.
{%- endcomment -%}

{%- if customer -%}
  <div
    id="deluxe-loyalty"
    class="dlx-loyalty"
    data-customer-id="{{ customer.id }}"
    data-middleware-url="{{ settings.loyalty_middleware_url | default: 'https://your-middleware.example.com' }}"
  >
    <div class="dlx-card">
      <div class="dlx-card__main">
        <div class="dlx-info">
          <div class="dlx-line">
            <span class="dlx-label">Available Points</span>
            <span class="dlx-colon">:</span>
            <span class="dlx-value" id="dlx-points">0</span>
          </div>
          <div class="dlx-line">
            <span class="dlx-label">Amount</span>
            <span class="dlx-colon">:</span>
            <span class="dlx-value" id="dlx-amount">R 0.00</span>
          </div>
        </div>
        <button class="dlx-btn" id="dlx-get" type="button" disabled>Get Discount Code</button>
      </div>

      <div class="dlx-code" id="dlx-code-row" hidden>
        <span class="dlx-code__text">Discount Code: <strong id="dlx-code"></strong></span>
        <button class="dlx-copy" id="dlx-copy" type="button">Copy</button>
      </div>

      <p class="dlx-msg" id="dlx-msg" role="alert" hidden></p>
    </div>

    <p class="dlx-rate" id="dlx-rate"></p>
  </div>

  <script>
    (function () {
      var root = document.getElementById('deluxe-loyalty');
      if (!root) return;

      var base = (root.getAttribute('data-middleware-url') || '').replace(/\/$/, '');
      var gid = 'gid://shopify/Customer/' + root.getAttribute('data-customer-id');

      var pointsEl = document.getElementById('dlx-points');
      var amountEl = document.getElementById('dlx-amount');
      var getBtn = document.getElementById('dlx-get');
      var codeRow = document.getElementById('dlx-code-row');
      var codeEl = document.getElementById('dlx-code');
      var copyBtn = document.getElementById('dlx-copy');
      var msgEl = document.getElementById('dlx-msg');
      var rateEl = document.getElementById('dlx-rate');

      var cfg = { pointsPerUnit: 100, minRedeemPoints: 100, unitValueZar: 3, currency: 'ZAR' };
      var maxRedeemable = 0;

      function showMsg(text) {
        msgEl.textContent = text;
        msgEl.hidden = false;
      }

      function fmtMoney(v) {
        return 'R ' + Number(v || 0).toFixed(2);
      }

      // 1. Load available points.
      fetch(base + '/loyalty/balance?shopifyCustomerId=' + encodeURIComponent(gid), {
        headers: { Accept: 'application/json', 'ngrok-skip-browser-warning': 'true' }
      })
        .then(function (r) {
          return r.json().then(function (b) {
            if (!r.ok) throw new Error(b.message || 'Could not load points');
            return b;
          });
        })
        .then(function (data) {
          cfg.pointsPerUnit = data.pointsPerUnit || cfg.pointsPerUnit;
          cfg.minRedeemPoints = data.minRedeemPoints || cfg.minRedeemPoints;
          cfg.unitValueZar = data.unitValueZar || cfg.unitValueZar;
          cfg.currency = data.currency || cfg.currency;

          // Conversion note, e.g. "100 Points = R3.00".
          rateEl.textContent = cfg.pointsPerUnit + ' Points = ' + fmtMoney(cfg.unitValueZar);

          if (!data.linked) {
            pointsEl.textContent = '0';
            amountEl.textContent = fmtMoney(0);
            showMsg('Your loyalty profile is not linked yet.');
            return;
          }

          pointsEl.textContent = Number(data.available).toLocaleString();
          amountEl.textContent = fmtMoney(data.availableValueZar);

          // Only whole R-increments can be redeemed.
          maxRedeemable = Math.floor(data.available / cfg.pointsPerUnit) * cfg.pointsPerUnit;
          if (maxRedeemable >= cfg.minRedeemPoints) {
            getBtn.disabled = false;
          } else {
            showMsg('Earn at least ' + cfg.minRedeemPoints + ' points to redeem.');
          }
        })
        .catch(function (e) {
          showMsg(e.message);
        });

      // 2. Get discount code -> redeem the available points (reserves them).
      getBtn.addEventListener('click', function () {
        msgEl.hidden = true;
        getBtn.disabled = true;
        getBtn.textContent = 'Please wait…';
        fetch(base + '/redemptions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'ngrok-skip-browser-warning': 'true' },
          body: JSON.stringify({ shopifyCustomerId: gid, points: maxRedeemable })
        })
          .then(function (r) {
            return r.json().then(function (b) {
              if (!r.ok) throw new Error(b.message || 'Redemption failed');
              return b;
            });
          })
          .then(function (data) {
            codeEl.textContent = data.discountCode;
            codeRow.hidden = false;
            getBtn.hidden = true;
            // Refresh the displayed available points (now reserved).
            var remaining = maxRedeemable ? Number(pointsEl.textContent.replace(/[^0-9]/g, '')) - data.points : 0;
            pointsEl.textContent = Math.max(0, remaining).toLocaleString();
            amountEl.textContent = fmtMoney(Math.max(0, remaining) / cfg.pointsPerUnit * cfg.unitValueZar);
          })
          .catch(function (e) {
            showMsg(e.message);
            getBtn.disabled = false;
            getBtn.textContent = 'Get Discount Code';
          });
      });

      // 3. Copy the code.
      copyBtn.addEventListener('click', function () {
        var code = codeEl.textContent || '';
        if (navigator.clipboard) navigator.clipboard.writeText(code);
        copyBtn.textContent = 'Copied';
        setTimeout(function () {
          copyBtn.textContent = 'Copy';
        }, 1500);
      });
    })();
  </script>

  <style>
    .dlx-loyalty {
      margin: 16px 0;
      font-size: 1rem;
    }
    .dlx-card {
      border: 1px solid #e3e3e3;
      border-radius: 12px;
      padding: 20px 24px;
      background: #fff;
    }
    .dlx-card__main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }
    .dlx-info {
      display: grid;
      gap: 8px;
    }
    .dlx-line {
      display: grid;
      grid-template-columns: 150px 12px auto;
      align-items: center;
      color: #1a1a1a;
    }
    .dlx-label {
      font-weight: 400;
    }
    .dlx-value {
      font-weight: 700;
    }
    .dlx-btn {
      background: #c49a4c;
      color: #fff;
      border: 0;
      border-radius: 10px;
      padding: 14px 22px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .dlx-btn:hover:not(:disabled) {
      background: #b98d3c;
    }
    .dlx-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .dlx-code {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 20px;
      padding-top: 4px;
    }
    .dlx-code__text {
      font-size: 1.05rem;
      color: #1a1a1a;
    }
    .dlx-code__text strong {
      letter-spacing: 1px;
    }
    .dlx-copy {
      background: none;
      border: 0;
      color: #2a44d1;
      font-weight: 600;
      cursor: pointer;
      font-size: 1rem;
    }
    .dlx-msg {
      margin: 12px 0 0;
      color: #b23b3b;
      font-size: 0.9rem;
    }
    .dlx-rate {
      margin: 8px 2px 0;
      color: #6b6b6b;
      font-size: 0.85rem;
    }
    @media (max-width: 480px) {
      .dlx-line {
        grid-template-columns: 130px 12px auto;
      }
    }
  </style>
{%- else -%}
  <p><a href="{{ routes.account_login_url }}">Log in</a> to redeem your loyalty points.</p>
{%- endif -%}
