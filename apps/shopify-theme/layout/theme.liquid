{%- elsif template.name == 'article' and article.metafields.custom.json_schema != blank -%}
  <script type="application/ld+json">
    {{ article.metafields.custom.json_schema }}
  </script>
{%- endif -%}
{%- comment -%} YBF Custom JSON Schema Meta Fields {%- endcomment -%}




