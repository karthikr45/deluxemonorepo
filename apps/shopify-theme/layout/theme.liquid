    {% comment %} Custom metafield for body tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_body.value }}
    {% comment %} End custom metafield for body tab like GTag tracking {% endcomment %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- liquid
      if settings.enable_page_transition
        render 'page-transition'
      endif
    -%}

    <div class="site-wrapper min-height-screen">
      {% sections 'header-group' %}

      <main id="MainContent" class="main-content content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    {% sections 'overlay-group' %}
    {%- liquid
      if template.name == 'product'
        section 'sticky-atc-bar'
      endif
      if settings.enable_back_to_top
        render 'back-to-top'
      endif
    -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% if settings.pcard_show_quickview_button or settings.pcard_choose_options_actions == 'open_popup' %}
      <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {% endif %}

{% comment %} YBF CUSTOM CART BUTTON {% endcomment %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const priceEl = document.getElementById("variant-price-display");

    function updateVariantPrice(variant) {
      if (!priceEl || !variant) return;
      priceEl.textContent = Shopify.formatMoney(variant.price, "{{ shop.money_format }}");
    }

    // Listen for Shopify variant change events
    document.addEventListener("variant:changed", function (event) {
      const variant = event.detail.variant;
      updateVariantPrice(variant);
    });

    // Fallback for older themes (Modiva uses option selectors)
    const variantPicker = document.querySelector('form[action="/cart/add"]');
    if (variantPicker) {
      variantPicker.addEventListener("change", () => {
        fetch(window.location.pathname + ".js")
          .then(res => res.json())
          .then(product => {
            const selectedVariant = product.variants.find(v => v.id == document.querySelector('[name="id"]').value);
            updateVariantPrice(selectedVariant);
          });
      });
    }
  });
</script>

  </body>
</html>
