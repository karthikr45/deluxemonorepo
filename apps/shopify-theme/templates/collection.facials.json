tion":"","column_gap":"extra-small","row_gap":"none","swipe_on_mobile":false,"columns_mobile":"2","padding_top":40,"padding_bottom":40,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"product_tabs_VhxeEJ":{"type":"product-tabs","blocks":{"tab_Wx6HEj":{"type":"tab","settings":{"title":"ALL","collection":"facials"}},"tab_AAFJLF":{"type":"tab","settings":{"title":"DR GRANDEL","collection":"dr-grandel-skincare"}},"tab_EyGBBQ":{"type":"tab","settings":{"title":"ENVIRON","collection":"environ-professional-skin-care"}},"tab_jcyJCn":{"type":"tab","settings":{"title":"NIMUE","collection":"nimue-skin-technology"}},"tab_RWmnPD":{"type":"tab","settings":{"title":"LAMELLE","collection":"lamelle-pharmaceuticals"}},"tab_zGHCrp":{"type":"tab","settings":{"title":"QMS","collection":"qms-skincare"}}},"block_order":["tab_Wx6HEj","tab_AAFJLF","tab_EyGBBQ","tab_jcyJCn","tab_RWmnPD","tab_zGHCrp"],"name":"t:sections.product-tabs.presets.name","settings":{"color_scheme":"","header_layout":"vertical","heading":"","heading_size":"h1","heading_highlight_style":"none","limit":12,"columns":4,"column_gap":"medium","row_gap":"inherit","grid_layout":"standard","pcard_image_ratio":"","columns_mobile":"1","swipe_on_mobile":true,"show_all_button_on_top":false,"button_label":"","button_link":"","button_style":"btn--primary","tabs_nav_style":"design-1","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"product-grid":{"type":"main-collection-product-grid","disabled":true,"custom_css":[],"settings":{"color_scheme":"scheme-1","products_per_page":15,"columns_desktop":3,"grid_layout":"standard","pagination":"number","enable_color_swatch":false,"enable_filtering":true,"filter_type":"vertical","enable_sorting":true,"expand_filter_groups":"Product type","columns_mobile":"2","padding_top":40,"padding_bottom":100,"show_section_divider":true,"divider_width":"fixed"}},"rich_text_yVp3jc":{"type":"rich-text","blocks":{"heading_jE9Aff":{"type":"heading","settings":{"heading":"Everything You Need to Know About Our Facials","heading_size":"h2","heading_highlight_style":"none"}},"text_yHKXcb":{"type":"text","settings":{"text":"<p>Regular, professional facials deliver more than ‘spa-day feels’. They nourish your skin with strong active ingredients. They speed up cell turnover and boost collagen production.<br\/><br\/>All of this happens while you relax under a warm duvet. Here’s why we recommend a treatment every 4–6 weeks:<br\/><\/p><ul><li><h3><strong>Multi-Layer Skin Rejuvenation: <\/strong><\/h3><\/li><\/ul><p>Cleansing, exfoliation, massage, masks, and LED or peel upgrades work together. This gives you a lasting “just-had-a-facial” glow.<\/p><ul><li><h3><strong>Personalised Face Scan:<\/strong> <\/h3><\/li><\/ul><p>Unsure where to start? Pop in for a complimentary digital skin analysis so our experts can build a custom plan.<\/p><ul><li><h3><strong>Top-Tier Product Lines:<\/strong> <\/h3><\/li><\/ul><p>Dr Grandel’s concentrated ampoules, QMS’s collagen-stimulating formulas and Environ’s vitamin-A science tackle everything from pigmentation to premature ageing.<\/p><ul><li><h3><strong>Minimal Downtime: <\/strong><\/h3><\/li><\/ul><p>Step out with nothing more than a rosy flush - perfectly safe before an event or shoot.<br\/><\/p>","text_size":"text-base"}}},"block_order":["heading_jE9Aff","text_yHKXcb"],"name":"Everything You Need to Know About Our Facials","settings":{"color_scheme":"scheme-9","content_alignment":"left","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_ULyhCU":{"type":"rich-text","blocks":{"heading_7MhmKV":{"type":"heading","settings":{"heading":"Signature Facial Collection Comparison","heading_size":"h2","heading_highlight_style":"none"}}},"block_order":["heading_7MhmKV"],"name":"Signature Facial Collection Comparison","settings":{"color_scheme":"scheme-1","content_alignment":"left","padding_top":50,"padding_bottom":0,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"custom_liquid_deTffc":{"type":"custom-liquid","custom_css":[],"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<table width=\"90%\" style=\"width: 90%; height: 19px; margin-left: auto; margin-right: auto;\">\n<tbody>\n<tr style=\"height: 19px;\">\n<td style=\"width: 30%; height: 19px;\"><strong>&nbsp;Treatment<\/strong><\/td>\n<td style=\"width: 30%; height: 19px;\"><strong>Perfect For<\/strong><\/td>\n<td style=\"width: 30%; height: 19px;\"><strong>Key Boosters<\/strong><\/td>\n<\/tr>\n<tr>\n<td style=\"width: 30%;\"><strong>Collagen Glow LED Facial<\/strong><\/td>\n<td style=\"width: 30%;\">Fine lines, loss of firmness<\/td>\n<td style=\"width: 30%;\">Red light therapy + hydrolysed collagen ampoules<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 30%;\"><strong>Deep Cleanse (Men &amp; Women)<\/strong><\/td>\n<td style=\"width: 30%;\">Congested pores, breakouts<\/td>\n<td style=\"width: 30%;\">Ultrasonic exfoliation + charcoal masque<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 30%;\"><strong>HydraGlow Skin Treatment<\/strong><\/td>\n<td style=\"width: 30%;\">Dull, dehydrated skin<\/td>\n<td style=\"width: 30%;\">Vacuum-based serum infusion + hyaluronic acid<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 30%;\"><strong><b id=\"docs-internal-guid-e3321ef4-7fff-e77e-ff19-a385594bb97a\"><span>Glycolic or TCA Peel<\/span><\/b><\/strong><\/td>\n<td style=\"width: 30%;\">Rough texture, pigmentation<\/td>\n<td style=\"width: 30%;\">Controlled chemical resurfacing<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 30%;\"><strong>Chocolate Facial<\/strong><\/td>\n<td style=\"width: 30%;\">Stress relief, dry skin<\/td>\n<td style=\"width: 30%;\">Antioxidant cocoa mask + warm stone massage<\/td>\n<\/tr>\n<\/tbody>\n<\/table>","color_scheme":"scheme-1","padding_top":50,"padding_bottom":50,"custom_class":""}},"rich_text_bdfyRn":{"type":"rich-text","blocks":{"text_Fj4Q8y":{"type":"text","settings":{"text":"<p>Bundle multiple zones (face, neck, décolletage or hands) for bigger savings—our dynamic pricing flexes to match your goals.<\/p>","text_size":"text-base"}}},"block_order":["text_Fj4Q8y"],"name":"Bundle multiple zones","settings":{"color_scheme":"scheme-1","content_alignment":"center","padding_top":0,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_FMRBTH":{"type":"rich-text","blocks":{"heading_KMnXqT":{"type":"heading","settings":{"heading":"What to Expect When Booking a Facial","heading_size":"h2","heading_highlight_style":"none"}}},"block_order":["heading_KMnXqT"],"name":"What to Expect When Booking a Facial","settings":{"color_scheme":"scheme-9","content_alignment":"left","padding_top":50,"padding_bottom":0,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"custom_liquid_ghkxBU":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<table width=\"90%\" style=\"width: 90%; height: 266px; margin-left: auto; margin-right: auto;\">\n<tbody>\n<tr style=\"height: 19px;\">\n<td style=\"width: 30%; height: 19px;\"><strong>&nbsp;Stage<\/strong><\/td>\n<td style=\"width: 30%; height: 19px;\"><strong>What Happens<\/strong><\/td>\n<td style=\"width: 30%; height: 19px;\"><strong>Insider Tips<\/strong><\/td>\n<\/tr>\n<tr style=\"height: 57px;\">\n<td style=\"width: 30%; height: 57px;\"><strong>Pre-Facial<\/strong><\/td>\n<td style=\"width: 30%; height: 57px;\">Arrive makeup-free; pause retinoids\/AHAs 48 h pre-visit.<\/td>\n<td style=\"width: 30%; height: 57px;\">Hydrate and skip harsh exfoliants.<\/td>\n<\/tr>\n<tr style=\"height: 95px;\">\n<td style=\"width: 30%; height: 95px;\"><strong>Treatment<\/strong><\/td>\n<td style=\"width: 30%; height: 95px;\">Tailored cleanse, steam, extractions (if needed), bespoke mask and massage; optional LED or peel add-ons.<\/td>\n<td style=\"width: 30%; height: 95px;\">Drift off - scalp massage included.<\/td>\n<\/tr>\n<tr style=\"height: 38px;\">\n<td style=\"width: 30%; height: 38px;\"><strong>Post-Facial<\/strong><\/td>\n<td style=\"width: 30%; height: 38px;\">Mild pinkness fades in hours; skin feels pillow-soft.<\/td>\n<td style=\"width: 30%; height: 38px;\">Wear SPF 50, avoid saunas &amp; heavy makeup 24h.<\/td>\n<\/tr>\n<tr style=\"height: 57px;\">\n<td style=\"width: 30%; height: 57px;\"><strong><b id=\"docs-internal-guid-e3321ef4-7fff-e77e-ff19-a385594bb97a\"><span>Long-Term<\/span><\/b><\/strong><\/td>\n<td style=\"width: 30%; height: 57px;\">Collagen remodelling and cell turnover peak ~4 weeks.<\/td>\n<td style=\"width: 30%; height: 57px;\">Re-book monthly for compound results.<\/td>\n<\/tr>\n<\/tbody>\n<\/table>","color_scheme":"scheme-9","padding_top":50,"padding_bottom":50,"custom_class":""}},"collapsible_tabs_APWaA9":{"type":"collapsible-tabs","blocks":{"collapsible_item_EJd9WW":{"type":"collapsible_item","settings":{"icon":"none","heading":"Will a facial irritate sensitive skin?","content":"<p>Not at Deluxe Laser & Aesthetics. Our therapists hand-pick soothing, fragrance-free formulas and can swap steam for cool compresses if your skin is reactive.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_efGcTN":{"type":"collapsible_item","settings":{"icon":"none","heading":"How long does a session take?","content":"<p>Most treatments clock in at 45–60 minutes; express options fit neatly into a lunch break.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_NU44cF":{"type":"collapsible_item","settings":{"icon":"none","heading":"Can men have facials?","content":"<p>Absolutely, our Deep Cleanse and Hydration facials are formulated with thicker, oilier men’s skin in mind.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_LRKmAF":{"type":"collapsible_item","settings":{"icon":"none","heading":"How soon can I wear makeup?","content":"<p>Give your fresh skin at least 12 hours to breathe; mineral powder is fine if you must glam up sooner.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_GkiErx":{"type":"collapsible_item","settings":{"icon":"none","heading":"What about cost?","content":"<p>Prices start at just R339 for an express cleanse. Multi-session packs, add-on LEDs and loyalty-point redemptions drop the per-visit price even further.<\/p>","custom_liquid":"","page":"","open":false}}},"block_order":["collapsible_item_EJd9WW","collapsible_item_efGcTN","collapsible_item_NU44cF","collapsible_item_LRKmAF","collapsible_item_GkiErx"],"name":"FAQ","settings":{"container":"fixed","color_scheme":"scheme-1","header_layout":"vertical","heading":"Frequently Asked Questions","heading_size":"h2","heading_highlight_style":"none","subheading":"","description":"","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--primary","column_gap":"large","row_gap":"inherit","item_style":"standard","item_color_scheme":"","item_heading_font":"heading","item_heading_size":"h4","item_icon_size":"extra-large","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_G4FVWi":{"type":"rich-text","blocks":{"heading_FXaiyU":{"type":"heading","settings":{"heading":"Book Your Facial Today","heading_size":"h2","heading_highlight_style":"none"}},"text_pVYqfn":{"type":"text","settings":{"text":"<p>Ready to swap tired, lacklustre skin for lit-from-within luminosity? <br\/><br\/>Choose your facial treatment,  collect instant loyalty points, and our team will do the rest. No more scrolling for facials near me, your personalised skin-revival ritual awaits at Deluxe Laser & Aesthetics. Rejuvenate, relax and reveal your best complexion yet.<\/p>","text_size":"text-base"}}},"block_order":["heading_FXaiyU","text_pVYqfn"],"name":"Book Your Facial Today","settings":{"color_scheme":"scheme-1","content_alignment":"left","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}}},"order":["breadcrumbs_Gxg9wp","rich_text_tDmPrz","banner","custom_content_RecVe9","product_tabs_VhxeEJ","product-grid","rich_text_yVp3jc","rich_text_ULyhCU","custom_liquid_deTffc","rich_text_bdfyRn","rich_text_FMRBTH","custom_liquid_ghkxBU","collapsible_tabs_APWaA9","rich_text_G4FVWi"]}