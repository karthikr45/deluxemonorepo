ow_section_divider":true,"divider_width":"fixed"}},"rich_text_yVp3jc":{"type":"rich-text","blocks":{"heading_jE9Aff":{"type":"heading","settings":{"heading":"Why Choose Nd:YAG at Deluxe?","heading_size":"h2","heading_highlight_style":"none"}},"text_yHKXcb":{"type":"text","settings":{"text":"<ul><li><h3><strong>Selective Photothermolysis: <\/strong><\/h3><\/li><\/ul><p>Ultrashort pulses shatter pigment granules without ablating the skin surface.<\/p><ul><li><h3><strong>All-Tone Safety: <\/strong><\/h3><\/li><\/ul><p>The long 1064 nm wavelength passes safely through surface melanin, reducing PIH risk on Fitzpatrick I–VI.<\/p><ul><li><h3><strong>Proven Versatility: <\/strong><\/h3><\/li><\/ul><p>Effective on hyperpigmentation, café-au-lait macules, melasma, freckles, age and sunspots, and multi-coloured tattoos.<\/p><ul><li><h3><strong>Low Downtime: <\/strong><\/h3><\/li><\/ul><p>Expect mild redness or frosting that settles within hours; make-up is usually fine the next day.<br\/><\/p>","text_size":"text-base"}}},"block_order":["heading_jE9Aff","text_yHKXcb"],"name":"Why choose ND Yag","settings":{"color_scheme":"scheme-9","content_alignment":"left","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_zcbAtE":{"type":"rich-text","blocks":{"heading_JQXidB":{"type":"heading","settings":{"heading":"What Can Nd:YAG Treat?","heading_size":"h2","heading_highlight_style":"none"}},"text_wbpJnL":{"type":"text","settings":{"text":"<h3><strong>1. Tattoo Removal<\/strong><\/h3><p>Black line work to full-colour art, see progressive fading over 4 to 8 sessions, spaced 8–12 weeks apart.<\/p><h3><strong>2. Pigmentation Correction: <\/strong><\/h3><p>Hyperpigmentation • Age\/Sunspots • Freckles • Birthmarks • Melasma \/ Chloasma<br\/><br\/>Recommended 1–3 treatments for small lesions; 8–12 for diffuse facial melasma.<\/p><h3><strong>3. “Laser Facial” Rejuvenation<\/strong><\/h3><p>A gentle, pigment-polishing pass that brightens dull skin, refines pores and stimulates fresh collagen over a course of 8–12 sessions.<\/p>","text_size":"text-base"}}},"block_order":["heading_JQXidB","text_wbpJnL"],"name":"What Can Nd:YAG Treat?","settings":{"color_scheme":"scheme-9","content_alignment":"left","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_RgX4Jr":{"type":"rich-text","blocks":{"heading_PJj7d6":{"type":"heading","settings":{"heading":"How the Technology Works","heading_size":"h2","heading_highlight_style":"none"}},"text_ErNPip":{"type":"text","settings":{"text":"<ul><li>A flash-lamp excites the Nd:YAG crystal, producing a 1064 nm beam.<\/li><li>The beam is Q-switched into billion-th-of-a-second bursts.<\/li><li>Target pigment absorbs the energy, rapidly heats, and fractures into minute particles.<\/li><li>Your lymphatic system clears the debris over the following weeks, revealing clearer skin.<br\/><\/li><\/ul><p>Book online, earn points, and relax; our experts customise pulse duration, fluence, and spot size to hit your exact goals.<br\/><\/p>","text_size":"text-base"}}},"block_order":["heading_PJj7d6","text_ErNPip"],"name":"How the Technology Works","settings":{"color_scheme":"","content_alignment":"left","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_ULyhCU":{"type":"rich-text","blocks":{"heading_7MhmKV":{"type":"heading","settings":{"heading":"Treatment Plans and Typical Results","heading_size":"h2","heading_highlight_style":"none"}}},"block_order":["heading_7MhmKV"],"name":"Treatment Plans and Typical Results","settings":{"color_scheme":"scheme-1","content_alignment":"left","padding_top":50,"padding_bottom":0,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"custom_liquid_deTffc":{"type":"custom-liquid","custom_css":[],"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<table width=\"90%\" style=\"width: 90%; height: 19px; margin-left: auto; margin-right: auto;\">\n<tbody>\n<tr style=\"height: 19px;\">\n<td style=\"width: 40%; height: 19px;\"><strong>Concern<\/strong><\/td>\n<td style=\"width: 10%; height: 19px;\"><strong>Sessions*<\/strong><\/td>\n<td style=\"width: 10%; height: 19px;\"><strong>Interval<\/strong><\/td>\n<td style=\"width: 40%; height: 19px;\"><strong>When You’ll Notice Change<\/strong><\/td>\n<\/tr>\n<tr>\n<td style=\"width: 40%;\"><strong>Tattoo (black\/colour)<\/strong><\/td>\n<td style=\"width: 10%;\">4-8<\/td>\n<td style=\"width: 10%;\">8-12 weeks<\/td>\n<td style=\"width: 40%;\">Ink visibly lightens after each visit; final clearance 9–18 months<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 40%;\"><strong>Diffuse hyperpigmentation \/ rejuvenation<\/strong><\/td>\n<td style=\"width: 10%;\">8-12<\/td>\n<td style=\"width: 10%;\">2-4 weeks<\/td>\n<td style=\"width: 40%;\">Gradual brightening; best result ≈ 3 months after last session<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 40%;\"><strong>Age \/ sunspots \/ freckles<\/strong><\/td>\n<td style=\"width: 10%;\">1-3<\/td>\n<td style=\"width: 10%;\">4 weeks<\/td>\n<td style=\"width: 40%;\">Lesions darken and flake within 7–10 days, then lighten<\/td>\n<\/tr>\n<tr>\n<td style=\"width: 40%;\"><strong>Café-au-lait macules<\/strong><\/td>\n<td style=\"width: 10%;\">1-3<\/td>\n<td style=\"width: 10%;\">8-12 weeks<\/td>\n<td style=\"width: 40%;\">Patch fades progressively; some may need maintenance<\/td>\n<\/tr>\n<\/tbody>\n<\/table>","color_scheme":"scheme-1","padding_top":50,"padding_bottom":50,"custom_class":""}},"collapsible_tabs_APWaA9":{"type":"collapsible-tabs","blocks":{"collapsible_item_EJd9WW":{"type":"collapsible_item","settings":{"icon":"none","heading":"Does the treatment hurt?","content":"<p>Most clients describe a fast, elastic-band “snap.” A chilled tip and cold air minimise discomfort.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_efGcTN":{"type":"collapsible_item","settings":{"icon":"none","heading":"Is Nd:YAG safe for darker skin?","content":"<p>Yes, 1064 nm energy bypasses epidermal melanin, dramatically lowering hyper-\/hypo-pigmentation risk on Fitzpatrick IV–VI.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_NU44cF":{"type":"collapsible_item","settings":{"icon":"none","heading":"How long is downtime?","content":"<p>Mild redness, frosting or pinpoint bleeding may appear and usually resolves within 24 hours. You can return to desk work immediately.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_LRKmAF":{"type":"collapsible_item","settings":{"icon":"none","heading":"When will I see results?","content":"<p>Pigmented spots darken, then slough off in 7–10 days.<br\/>Tattoo ink continues to fade for 8 weeks after each session.<br\/>Rejuvenation clients notice a progressive glow that peaks a month after the final visit.<\/p>","custom_liquid":"","page":"","open":false}},"collapsible_item_GkiErx":{"type":"collapsible_item","settings":{"icon":"none","heading":"Can I combine this with other treatments?","content":"<p>Absolutely, pair with chemical peels or LED light therapy for faster brightening. Your therapist will design a safe timeline.<\/p>","custom_liquid":"","page":"","open":false}}},"block_order":["collapsible_item_EJd9WW","collapsible_item_efGcTN","collapsible_item_NU44cF","collapsible_item_LRKmAF","collapsible_item_GkiErx"],"name":"FAQ","settings":{"container":"fixed","color_scheme":"scheme-9","header_layout":"vertical","heading":"Frequently Asked Questions","heading_size":"h1","heading_highlight_style":"none","subheading":"","description":"","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--primary","column_gap":"large","row_gap":"inherit","item_style":"standard","item_color_scheme":"","item_heading_font":"heading","item_heading_size":"h4","item_icon_size":"extra-large","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}},"rich_text_G4FVWi":{"type":"rich-text","blocks":{"heading_FXaiyU":{"type":"heading","settings":{"heading":"Book Your Nd:YAG Session Today","heading_size":"h2","heading_highlight_style":"none"}},"text_pVYqfn":{"type":"text","settings":{"text":"<p>Ready to lift unwanted pigment and rediscover luminous skin? <\/p><p>Choose your treatment, collect instant loyalty points, and our team will do the rest. Your journey to clearer, confidence-boosting skin starts here.<\/p>","text_size":"text-base"}}},"block_order":["heading_FXaiyU","text_pVYqfn"],"name":"Book Your Facial Today","settings":{"color_scheme":"scheme-9","content_alignment":"left","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","custom_class":""}}},"order":["breadcrumbs_Gxg9wp","rich_text_tDmPrz","banner","custom_content_RecVe9","product-grid","rich_text_yVp3jc","rich_text_zcbAtE","rich_text_RgX4Jr","rich_text_ULyhCU","custom_liquid_deTffc","collapsible_tabs_APWaA9","rich_text_G4FVWi"]}