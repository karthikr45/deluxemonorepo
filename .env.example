# ---------------------------------------------------------------------------
# Root example env. Copy to .env and fill in. Each app also reads these vars.
# NEVER commit real credentials. .env is gitignored.
# ---------------------------------------------------------------------------

# --- Database (Postgres) ---
DATABASE_URL="postgresql://deluxe:deluxe@localhost:5432/deluxe_loyalty?schema=public"

# --- NestJS API ---
API_PORT=4000
API_BASE_URL="http://localhost:4000"

# --- Next.js dashboard ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# --- Shopify Admin API (custom app) ---
SHOPIFY_STORE_DOMAIN="deluxe.myshopify.com"
SHOPIFY_ADMIN_API_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2024-07"
SHOPIFY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# --- Zenoti API ---
# ZENOTI_MODE=live uses the real Zenoti API — point ZENOTI_API_BASE_URL at your
# TEST/sandbox tenant and use its API key/center id. (mock is an opt-in offline
# test provider, off by default.)
ZENOTI_MODE="live"
ZENOTI_MOCK_DEFAULT_POINTS=500
ZENOTI_API_BASE_URL="https://api.zenoti.com/v1"
ZENOTI_API_KEY="apikey xxxxxxxxxxxxxxxxxxxxxxxx"
ZENOTI_CENTER_ID="00000000-0000-0000-0000-000000000000"

# --- Loyalty economics ---
# 100 points = R3.00 (ZAR). Discount codes valid 6 months, usage limit 1/order.
LOYALTY_POINTS_PER_UNIT=100
LOYALTY_UNIT_VALUE_ZAR=3
LOYALTY_MIN_REDEEM_POINTS=100
LOYALTY_CODE_VALIDITY_MONTHS=6
LOYALTY_CURRENCY=ZAR
